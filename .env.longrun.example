# Configuration tuned for a long-running instance behind a tunnel.
#
# The single biggest factor in how long a LinkedIn session survives is how many requests you
# make and how fast. Every setting here trades throughput for session lifetime, which is the
# right trade when a dead session costs a manual browser re-login.
#
# Copy to .env on the machine that will run the service, then fill in the two cookie values
# immediately before starting it — a cookie captured hours earlier may already be dead.

# --- Credentials (capture fresh, right before starting) ---------------------------------
# DevTools > Application > Cookies > https://www.linkedin.com
LI_AT_COOKIE=
LI_JSESSIONID=

# DELIBERATELY UNSET. This carries __cf_bm, which expires after 30 minutes of inactivity;
# replaying a stale value makes the service redirect-loop permanently. Left empty, the service
# mints and refreshes its own volatile cookies and keeps working indefinitely.
# LI_COOKIE_JAR=

# --- Fingerprint -------------------------------------------------------------------------
IMPERSONATE=chrome

# --- Pacing: the setting that most affects session lifetime -------------------------------
# Published guidance for this surface is 1-2 requests/minute and ~80-100/day per account.
# These sit at the cautious end: roughly one request every 60-90 seconds.
# Raising them costs latency on a cache miss and buys session longevity.
MIN_REQUEST_INTERVAL_S=60
REQUEST_JITTER_S=30

# Stop after two consecutive auth failures rather than continuing to hammer a rejected session.
# Continuing is what escalates a logout into an account restriction.
SESSION_FAILURE_THRESHOLD=2

# --- Caching: the cheapest way to avoid requests entirely ---------------------------------
# A week. Profiles rarely change materially, and every cache hit is a LinkedIn request not made.
# Repeat lookups of the same profile then cost nothing at all.
CACHE_TTL_HOURS=168

# --- Long-poll window ---------------------------------------------------------------------
# Must comfortably exceed MIN_REQUEST_INTERVAL_S, or a queued request returns 202 rather than
# waiting out the pacing interval. 120s keeps most calls looking synchronous.
LONG_POLL_TIMEOUT_S=120

# --- Server -------------------------------------------------------------------------------
PORT=8000

# Persist the store so the cache and raw-page history survive restarts. On a machine you
# control this is a real directory, unlike a PaaS with an ephemeral filesystem.
DATA_DIR=data

# --- Optional -----------------------------------------------------------------------------
# Only if routing through a sticky residential proxy. Unnecessary when the machine running this
# is already on a residential connection, which is the point of the tunnel.
# LINKEDIN_PROXY=http://user:pass@host:port
