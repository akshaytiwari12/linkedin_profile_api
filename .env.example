# --- LinkedIn session (from a logged-in browser: DevTools > Application > Cookies) ---
# The li_at cookie value.
LI_AT_COOKIE=

# The JSESSIONID cookie value. Paste it with or without the surrounding double quotes —
# the app normalizes it and applies the correct quoting to the cookie vs. the csrf-token header.
LI_JSESSIONID=ajax:0000000000000000000

# --- Fingerprint ---
# curl_cffi impersonation target (chrome, chrome124, safari17_0, edge101, ...).
IMPERSONATE=chrome

# --- Network identity (optional) ---
# LinkedIn ties a session to the IP it was created on. Leave UNSET when running locally on the
# machine the cookie came from. For a deployed instance, point this at a STICKY residential
# proxy in the same region as the login — a rotating pool invalidates the session immediately.
# LINKEDIN_PROXY=http://user:pass@host:port

# --- Server ---
PORT=8000

# --- Storage ---
DATA_DIR=data
FIXTURES_DIR=fixtures

# --- Tuning (conservative by default; an invalidated session needs a manual browser re-login) ---
CACHE_TTL_HOURS=48
MIN_REQUEST_INTERVAL_S=40
REQUEST_JITTER_S=20
SESSION_FAILURE_THRESHOLD=2
LONG_POLL_TIMEOUT_S=25
