# Session cookie from a logged-in LinkedIn browser session (DevTools > Application > Cookies > linkedin.com > li_at).
LI_AT_COOKIE=

# JSESSIONID cookie from the same session (DevTools > Application > Cookies > linkedin.com > JSESSIONID).
# LinkedIn wraps it in double quotes, e.g. "ajax:1234567890123456789" — include the quotes.
LI_JSESSIONID="ajax:0000000000000000000"

# Port the server listens on.
PORT=3000
